# Build trees, one per preset (build/dev, build/asan, ...), and the generated documentation.
/build/

# The report that gcovr writes for the coverage job, and for the same command run by hand.
/coverage/

# Tooling caches and the compilation database some editors drop in the source root.
/.cache/
/compile_commands.json

# Editors and the operating system.
.idea/
.vscode/
.DS_Store

# What libFuzzer leaves in the working directory when a fuzz target is run from the source root
# without -artifact_prefix. A crash is a regression input to move into a test, not to commit as is.
/crash-*
/oom-*
/timeout-*
/leak-*
/slow-unit-*
